    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT 1 AS ok FROM otp_codigos WHERE cedula = $1 AND creado_en > NOW() - INTERVAL '60 seconds' ORDER BY creado_en DESC LIMIT 1",
        "options": {
          "queryReplacement": "={{ [ $json.body.cedula ] }}"
        }
      },
