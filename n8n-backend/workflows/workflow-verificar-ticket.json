      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "JLa71HK5Hh0dITa4",
          "name": "YaviBot PostgreSQL - Servidor"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
