      "id": "a6c6a501-6483-4c45-85e6-e5646e295f28",
      "name": "Responder: CORS preflight",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        688,
        448
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) AS intentos FROM eventos WHERE tipo = 'TicketVerificacionFallida' AND payload->>'cedula' = $1 AND creado_en > NOW() - INTERVAL '10 minutes'",
        "options": {
          "queryReplacement": "={{ [ $json.body.cedula ] }}"
        }
      },
      "id": "73ce84de-584e-42e8-8d54-3ecda51dd0ab",
      "name": "Verificar Intentos Fallidos (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        688,
        304
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "JLa71HK5Hh0dITa4",
          "name": "YaviBot PostgreSQL - Servidor"
        }
      },
      "notes": "El ticket es un código de 6 dígitos (1 millón de combinaciones) y este endpoint no tenía ningún límite de intentos — se podía intentar adivinarlo por fuerza bruta dentro de su ventana de 10 min. Máximo 5 intentos fallidos por cédula cada 10 min."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.intentos }}",
              "rightValue": 5,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "69d7eca9-2cb4-46ef-98b2-8386b297719a",
      "name": "¿Bajo el límite de intentos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        944,
        304
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"Demasiados intentos fallidos. Solicita un nuevo código e intenta de nuevo.\" } }}",
        "options": {
          "responseCode": 429,
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "id": "3845c92d-afa6-49ec-82f5-32d4fe074534",
      "name": "Responder: Demasiados intentos",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        464
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id FROM otp_codigos WHERE cedula = $1 AND codigo_hash = encode(digest($2, 'sha256'), 'hex') AND usado = FALSE AND expira_en > NOW() AND canal = 'chatbot' ORDER BY creado_en DESC LIMIT 1",
        "options": {
          "queryReplacement": "={{ [$('Webhook').item.json.body.cedula, $('Webhook').item.json.body.ticket] }}"
        }
      },
      "id": "c5f37ac5-7e20-4df9-a33a-fc0c37c91cb2",
      "name": "Buscar Ticket Vigente (Postgres)",
      "type": "n8n-nodes-base.postgres",
