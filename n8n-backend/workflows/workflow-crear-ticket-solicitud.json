        "query": "UPDATE tickets SET responsable_id = (SELECT usuario_id FROM asignaciones_responsables WHERE tipo_solicitud_id = $1 AND (carrera_id = $2 OR carrera_id IS NULL) AND vigente = true ORDER BY carrera_id NULLS LAST LIMIT 1) WHERE id = $3 RETURNING id, responsable_id",
