        "options": {
          "queryReplacement": "={{ [$('Buscar Tipo de Trámite (Postgres)').item.json.tipo_solicitud_id, $('Buscar Estudiante (Postgres)').item.json.estudiante_id, $('Buscar Estudiante (Postgres)').item.json.carrera_id, $('Buscar Estudiante (Postgres)').item.json.nivel, $('Buscar Estudiante (Postgres)').item.json.paralelo] }}"
        }
